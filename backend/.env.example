# EmamiApps hub backend — login (hub-auth.js) + Manage Access API (server.js).
# Copy this file to .env and fill in real values. .env is gitignored; never commit real credentials.

# Comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:8081,https://www.emamiapps.in

# Local dev only — Lambda ignores this (deploy-lambdas.js strips it before upload).
PORT=4000

# Postgres (Development Environment DB) — backs Manage Access (authorized_users/
# authorized_user_apps) AND login itself (hub-auth.js checks this same table).
# Same instance as embedded-apps/mouldhealthcheck/backend/.env.
PGHOST=10.17.12.4
PGPORT=5432
PGDATABASE=Devhubfactory
PGUSER=Devhubuser
PGPASSWORD=

# SAP app registration's client secret — hub-auth.js reuses this same app registration
# (a different, delegated OAuth scope) for the Microsoft sign-in option.
CLIENT_SECRET=
# Any long random string — signs the short-lived session token issued after login
# (either path: Microsoft or direct email). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_AUTH_JWT_SECRET=
# Where the browser gets redirected back to after a Microsoft sign-in.
HUB_AUTH_FRONTEND_URL=https://www.emamiapps.in
