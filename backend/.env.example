# EmamiApps hub backend — login (direct email in hub-auth.js, Microsoft SAML in saml-sso.js) +
# Manage Access API (server.js).
# Copy this file to .env and fill in real values. .env is gitignored; never commit real credentials.

# Comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:8081,https://www.emamiapps.in

# Local dev only — Lambda ignores this (deploy-lambdas.js strips it before upload).
PORT=4000

# Postgres (Development Environment DB) — backs Manage Access only (server.js's /access/users
# routes: authorized_users/authorized_user_apps). Login itself (hub-auth.js, saml-sso.js) doesn't
# touch Postgres — the SAML IdP metadata is a static file (backend/azure-idp-metadata.xml, see
# idpConfig.js) and authorizedUsers.js's post-login gate is currently a no-op (allows everyone).
# Same DB instance as embedded-apps/mouldhealthcheck/backend/.env. Leave these unset if you only
# care about testing login/SSO — Manage Access API calls will just 500 without them.
PGHOST=10.17.12.4
PGPORT=5432
PGDATABASE=Devhubfactory
PGUSER=Devhubuser
PGPASSWORD=

# Kill switch for Microsoft sign-in (idpConfig.js) — separate from whether
# backend/azure-idp-metadata.xml exists, so an admin can instantly disable login (e.g. the
# certificate looks wrong) via the Lambda's environment variables, with no code change or
# redeploy. Must be the literal string "true" to enable; anything else (including unset) is off.
HUB_AUTH_SAML_ENABLED=false

# Any long random string — signs the short-lived session token issued after login
# (either path: Microsoft SAML or direct email). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_AUTH_JWT_SECRET=
# Where the browser gets redirected back to after a Microsoft sign-in.
HUB_AUTH_FRONTEND_URL=https://www.emamiapps.in

# SAML SP identifiers (saml-sso.js) — the "Configure SSO" screen shows these so an admin can
# copy-paste them into the Azure Enterprise Application's "Identifier" and "Reply URL" fields.
# They must match EXACTLY what's registered there, so — unlike the old OAuth2 redirect_uri,
# which was derived per-request — these are fixed. Leaving them unset falls back to a
# request-derived guess, which is fine for local dev but not for production.
HUB_AUTH_SAML_SP_ENTITY_ID=https://www.emamiapps.in/saml/sp
HUB_AUTH_SAML_ACS_URL=https://<your-api-gateway-invoke-url>/api/hub-auth/saml/acs

# Only needed on a deployment with no route to Postgres (the hub-auth Lambda — see
# scripts/deploy-lambdas.js's VPC comment). Points authorizedUsers.isAuthorized() at a
# Postgres-reachable deployment of this same backend instead of querying Postgres directly.
# Leave unset on a deployment that can already reach PGHOST directly (e.g. one running on the
# same internal network as Postgres) — that one should keep querying Postgres itself.
MANAGE_ACCESS_API_URL=https://audit-capa-api.emamiapps.in/api

# Audit & CAPA's own backend base URL (see embedded-apps/audit-capa/backend), NOT the same thing as
# MANAGE_ACCESS_API_URL above despite the similar-looking hostname — this one has to actually reach
# Audit & CAPA's own backend/routes/internal.js, wherever that's really deployed (e.g.
# http://localhost:5000/api if it happens to run on the same box as this one, or its real internal
# URL otherwise). Used by auditCapaSync.js so that assigning a CQA/Depot role in Manage Access takes
# effect inside Audit & CAPA immediately, instead of someone re-running that app's
# backend/sql/seed-users.js by hand. Left unset, a CQA/Depot grant still saves fine here, but
# auditCapaSync.js logs a warning and skips pushing it into Audit & CAPA's own table — set this and
# restart this backend for the sync to actually happen.
AUDIT_CAPA_API_URL=

# Shared secret for the internal call above — Audit & CAPA's own backend must have the exact same
# value in its AUDIT_CAPA_SYNC_SECRET (see embedded-apps/audit-capa/backend/.env.example). NOT the
# same as HUB_AUTH_JWT_SECRET below: on the real deployment those two backends' copies of that
# variable turned out to already be out of sync with each other (this backend isn't the one real
# end-user logins are issued from — that's a separate Lambda deployment), so don't assume reusing
# it here would work. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_CAPA_SYNC_SECRET=

# No env vars needed for the Home page's live Emami Limited share quote (stockQuote.js) — it uses
# Yahoo Finance's free public endpoint, no API key or account required. See stockQuote.js for why
# (and for the caveat that it's an unofficial, unversioned endpoint).

# Magic-link sign-in for non-@emamigroup.com emails (magicLink.js) — @emamigroup.com always goes
# through Microsoft SSO (saml-sso.js) instead and never touches this. Both required for the send
# step to work at all; leaving them unset makes /hub-auth/magic-link/request fail with a clear
# "not configured" error rather than silently doing nothing.
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard, e.g. "Emami Apps <noreply@emamiapps.in>".
RESEND_FROM_EMAIL=

# Shared secret for server-to-server calls to GET /access/users (sent as X-Internal-Secret) —
# embedded-apps/timesheet/server uses it for its Add employee search. Must match that server's
# HUB_INTERNAL_API_SECRET exactly. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_INTERNAL_API_SECRET=

# Samadhan service desk (backend/samadhan).
# Left empty here on purpose: an empty value falls back to the old name, then to the default (mail off, WhatsApp off,
# AI on when ANTHROPIC_API_KEY is set, Graph API v21.0, schema samadhan). Never commit real values.
SAMADHAN_MAIL_ENABLED=
SAMADHAN_MAILBOX=
SAMADHAN_AI_ENABLED=
SAMADHAN_WHATSAPP_ENABLED=
SAMADHAN_WHATSAPP_TOKEN=
SAMADHAN_WHATSAPP_PHONE_NUMBER_ID=
SAMADHAN_WHATSAPP_APP_SECRET=
SAMADHAN_WHATSAPP_VERIFY_TOKEN=
SAMADHAN_WHATSAPP_API_VERSION=
SAMADHAN_DB_SCHEMA=
# Samadhan attachments (v7): sftp (production) | local (tests only) | empty = attachments off.
SAMADHAN_STORAGE=
SAMADHAN_SFTP_HOST=
SAMADHAN_SFTP_PORT=
SAMADHAN_SFTP_USER=
# Either a password or a private key file (+ passphrase):
SAMADHAN_SFTP_PASSWORD=
SAMADHAN_SFTP_PRIVATE_KEY_PATH=
SAMADHAN_SFTP_PASSPHRASE=
# Absolute folder for Samadhan's files on the SFTP server, e.g. /samadhan
SAMADHAN_SFTP_BASE_DIR=
# Required: the server's host key fingerprint(s), comma separated, e.g. SHA256:abc... (ssh-keyscan host | ssh-keygen -lf -)
SAMADHAN_SFTP_HOST_FINGERPRINT=
SAMADHAN_STORAGE_DIR=

# ---- SmarTruck TMS (tms.js) -----------------------------------------------------------------------------------------------
# SAP service ZTMS_SRV. Empty = SIMULATED (fake documents, flagged in the app). EDS direct (dev, basic auth) or the Azure hub once
# Basis has registered ZTMS_SRV there (then TMS_SAP_AUTH=gateway, no user/password).
TMS_SAP_ODATA_BASE=
TMS_SAP_CLIENT=900
TMS_SAP_AUTH=gateway
TMS_SAP_USER=
TMS_SAP_PASSWORD=
# Tracking feed (GPS / SIM / IoT) posts to /api/me/smartruck-tms/ingest/ping with header x-tms-key. At least 16 characters; empty disables ingest.
TMS_INGEST_KEY=
# Optional providers (each runs simulated when empty): telecom SIM consent, GST e-way bill, e-mail/SMS.
TMS_CONSENT_URL=
TMS_CONSENT_KEY=
TMS_EWAY_BASE=
TMS_EWAY_KEY=
TMS_NOTIFY_URL=
TMS_NOTIFY_KEY=
# Run the 60 s background sweep (auction close, GPS gaps, e-way warnings, SAP payment sync) on ONE process per environment; off on the others.
TMS_BACKGROUND=on

# Publicity Expenses (backend/publicityExpenses/): SAP OData ZC_ATLBTL_EXP_SUMMARY_CDS / ZC_ATLBTL_EXP_DETAIL_CDS (dev: EDS client 900).
# Empty ODATA_ROOT (and no service bases) = mock data. PUBEXP_SOURCE=mock|sap forces the source. Never commit real values.
# Azure SAP gateway (dev): PUBEXP_SAP_SUMMARY_BASE=https://<gateway>/api/NGD/ZC_ATLBTL_EXP_SUMMARY_CDS, PUBEXP_SAP_DETAIL_BASE=.../ZC_ATLBTL_EXP_DETAIL_CDS
# (gateway mode is taken from that URL shape; no user / password - the gateway signs in). PUBEXP_SAP_MODE=direct|gateway overrides.
PUBEXP_SAP_ODATA_ROOT=
PUBEXP_SAP_SUMMARY_BASE=
PUBEXP_SAP_DETAIL_BASE=
PUBEXP_SAP_MODE=
PUBEXP_SAP_CLIENT=900
PUBEXP_SAP_SYSTEM=EDS
PUBEXP_SAP_USER=
PUBEXP_SAP_PASSWORD=
PUBEXP_SAP_TIMEOUT_MS=
PUBEXP_SOURCE=
# OB / RB budget: mock (default) until the budget table is joined in the AMDP; sap = use the CDS values.
PUBEXP_BUDGET_SOURCE=
