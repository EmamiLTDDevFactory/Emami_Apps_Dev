{
  "name": "samadhan",
  "version": "1.0.0",
  "private": true,
  "description": "Samadhan: Emami service desk (tickets, SLA, severity matrix, automations) on the shared Emami Apps backend",
  "scripts": {
    "dev": "next dev -p 3250",
    "build": "next build && node scripts/rename-export.js",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir src --dir e2e --max-warnings 2",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:gate": "node ../../backend/samadhan/tests/gate.js"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
