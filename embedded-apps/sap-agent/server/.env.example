# SAP system (DEVELOPMENT ONLY): EDS.
# Web app: every person signs in with THEIR OWN SAP user ID and password (kept in server memory for the
# session only) and types their Anthropic API key - leave SAP_USER / SAP_PASSWORD / ANTHROPIC_API_KEY empty.
# The CLI (sap-agent ...) still reads them from here.
SAP_HOST=https://<eds-host>:<https-port>
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
SAP_VERIFY_SSL=true
# Safety rails
SAP_ALLOWED_SIDS=EDS
SAP_ALLOWED_PACKAGES=ZEMAMI
SAP_READ_ONLY=false
SAP_ALLOW_RELEASE=false
SAP_APPROVAL=prompt
# Naming: NO prefix rules. Any valid name is allowed. Standard objects are protected by package ownership
# (the agent only creates or changes objects in SAP_ALLOWED_PACKAGES). Optional extra restrictions, as regexes:
# SAP_NAME_PATTERNS=Z.*,Y.*
# SAP_USER_PATTERNS=EMAMI_.*
# SAP_ROLE_PATTERNS=EMAMI_.*
# SAP_ROLE_DENYLIST=SAP_.*,S_A\..*
# LLM
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_STEPS=60
AUDIT_FILE=./audit.jsonl

# --- Web layer (sap_agent_web: HTTP API for the Emami Apps embedded UI) --------------------------
# Same secret the Emami Apps hub signs its session tokens with (dev and prod hubs differ).
HUB_AUTH_JWT_SECRET=
# This server's own session tokens: long random string.
SESSION_SECRET=
# Manage Access: only people with role "Admin" on app id sap-agent may use the agent.
HUB_ACCESS_API_BASE=https://audit-capa-api.emamiapps.in/dev-api/api
HUB_APP_ID=sap-agent
ALLOWED_ORIGINS=https://dev.emamiapps.in,https://www.emamiapps.in
# Pending approvals are denied after this many seconds.
APPROVAL_TIMEOUT_S=900
# Local development only: POST /api/session/dev signs in any email as Admin. Never on a server.
ALLOW_DEV_LOGIN=false
