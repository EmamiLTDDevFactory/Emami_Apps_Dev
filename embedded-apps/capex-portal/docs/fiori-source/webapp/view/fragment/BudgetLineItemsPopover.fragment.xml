<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <ResponsivePopover
        title="{lineItems>/title}"
        placement="Bottom"
        contentWidth="28rem">
        <content>
            <Table items="{lineItems>/items}" class="sapUiNoMargin" noDataText="{i18n>noItemsYet}">
                <columns>
                    <Column width="3rem"><Text text="{i18n>itemNo}"/></Column>
                    <Column><Text text="{i18n>itemTitlePlaceholder}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>budgetAmount}"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>itemRemarksPlaceholder}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{lineItems>itemNo}"/>
                            <Text text="{lineItems>title}"/>
                            <Text text="{path: 'lineItems>amount', formatter: '.formatter.inLakhs'}" class="zcpxNum"/>
                            <Text text="{path: 'lineItems>remarks', formatter: '.formatter.orDash'}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </ResponsivePopover>

</core:FragmentDefinition>
