<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog title="{preview>/title}" contentWidth="36rem" contentHeight="28rem" resizable="true" draggable="true">
        <content>
            <VBox id="vbPreviewContent" width="100%" height="100%" alignItems="Center" justifyContent="Center"/>
        </content>
        <beginButton>
            <Button text="{i18n>docDownload}" icon="sap-icon://download" press=".onDownloadFromPreview"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>close}" press=".onClosePreview"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
