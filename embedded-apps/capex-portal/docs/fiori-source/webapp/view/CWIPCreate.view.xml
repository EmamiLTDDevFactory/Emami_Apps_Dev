<mvc:View
    controllerName="zcapexportal.controller.CWIPCreate"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    height="100%">

    <Page
        id="pageCWIPCreate"
        title="{i18n>cwipCreateTitle}"
        showNavButton="true"
        navButtonPress=".onBack"
        class="zcpxApp">

        <content>
            <VBox class="zcpxScreen">

                <VBox class="zcpxHero zcpxSection">
                    <Text text="{detail>/cpeId} — {detail>/title}" class="zcpxHeroTitle"/>
                    <Text
                        text="{detail>/plantName} · {path: 'detail>/amount', formatter: '.formatter.inLakhs'} · Vendor: {detail>/vendorName}"
                        class="zcpxHeroSub"/>
                </VBox>

                <MessageStrip
                    class="zcpxSection"
                    text="CPE is fully approved. Complete the fields below and push to SAP — the Internal Order, CWIP element and Purchase Order are created automatically."
                    type="Success"
                    showIcon="true"
                    visible="{= !${detail>/vendorCodeBlocked} }"/>

                <!-- Rev3 T6: only shown once the live backend's CPE entity
                     actually carries a vendor code field and this CPE still
                     has none set - see CWIPCreate.controller.js#_onMatched. -->
                <MessageStrip
                    class="zcpxSection"
                    text="{i18n>vendorCodeMissing}"
                    type="Error"
                    showIcon="true"
                    visible="{detail>/vendorCodeBlocked}"/>

                <!-- ==========================================================
                     CWIP FIELDS
                     ========================================================== -->
                <VBox class="zcpxCard zcpxSection">
                    <HBox class="zcpxCardHeader" alignItems="Center">
                        <core:Icon src="sap-icon://building" class="sapUiTinyMarginEnd"/>
                        <Text text="CWIP / Asset Under Construction" class="zcpxCardTitle"/>
                    </HBox>
                    <VBox class="zcpxCardBody">
                        <f:SimpleForm
                            layout="ResponsiveGridLayout"
                            editable="true"
                            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                            adjustLabelSpan="false"
                            columnsXL="2" columnsL="2" columnsM="1">
                            <f:content>

                                <Label text="{i18n>assetClass}" required="true"/>
                                <ComboBox
                                    id="cbAssetClass"
                                    selectedKey="{procure>/cwipDraft/assetClass}"
                                    items="{procure>/assetClasses}"
                                    change=".onAssetClassChange">
                                    <core:Item key="{procure>key}" text="{procure>text}"/>
                                </ComboBox>

                                <Label text="{i18n>assetDesc}"/>
                                <Input
                                    id="inpAssetDesc"
                                    value="{procure>/cwipDraft/assetDesc}"
                                    maxLength="50"
                                    placeholder="e.g. Injection Moulding Machine - Line 3"/>

                                <Label text="{i18n>wbsElement}"/>
                                <Input
                                    value="{procure>/cwipDraft/wbsElement}"
                                    placeholder="Auto-generated by SAP on posting"
                                    editable="false"
                                    class="zcpxAutoFilled"/>

                                <Label text="{i18n>costCenter}" required="true"/>
                                <Input
                                    id="inpCostCenter"
                                    value="{procure>/cwipDraft/costCenter}"
                                    placeholder="e.g. 1100-PROD-01"/>

                                <Label text="{i18n>profitCenter}"/>
                                <Input
                                    value="{procure>/cwipDraft/profitCenter}"
                                    placeholder="e.g. PC-1100"/>

                            </f:content>
                        </f:SimpleForm>
                    </VBox>
                </VBox>

                <!-- ==========================================================
                     PO FIELDS
                     ========================================================== -->
                <VBox class="zcpxCard zcpxSection">
                    <HBox class="zcpxCardHeader" alignItems="Center">
                        <core:Icon src="sap-icon://shipping-status" class="sapUiTinyMarginEnd"/>
                        <Text text="Purchase Order Details" class="zcpxCardTitle"/>
                    </HBox>
                    <VBox class="zcpxCardBody">
                        <f:SimpleForm
                            layout="ResponsiveGridLayout"
                            editable="true"
                            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                            adjustLabelSpan="false"
                            columnsXL="2" columnsL="2" columnsM="1">
                            <f:content>

                                <Label text="{i18n>vendor}"/>
                                <Input value="{detail>/vendorName}" editable="false" class="zcpxAutoFilled"/>

                                <Label text="PO Value"/>
                                <Input
                                    value="{path: 'detail>/amount', formatter: '.formatter.rupees'}"
                                    editable="false"
                                    class="zcpxAutoFilled"/>

                                <Label text="{i18n>executionProcess}" required="true"/>
                                <ComboBox
                                    id="cbExecution"
                                    selectedKey="{procure>/cwipDraft/executionProcess}"
                                    items="{procure>/executionProcesses}">
                                    <core:Item key="{procure>key}" text="{procure>text}"/>
                                </ComboBox>

                                <Label text="{i18n>timeframe}" required="true"/>
                                <Input
                                    id="inpTimeframe"
                                    value="{procure>/cwipDraft/timeframeWeeks}"
                                    type="Number"
                                    description="weeks"
                                    width="10rem"/>

                            </f:content>
                        </f:SimpleForm>

                        <Label text="{i18n>paymentTerms}" required="true" class="sapUiSmallMarginTop"/>
                        <TextArea
                            id="taPaymentTerms"
                            value="{procure>/cwipDraft/paymentTerms}"
                            rows="3" width="100%" growing="true" growingMaxLines="6" maxLength="800"
                            placeholder="e.g. 30% advance against PI, 60% against dispatch documents, 10% after successful commissioning."/>

                        <Label text="{i18n>remarks}" class="sapUiSmallMarginTop"/>
                        <TextArea
                            value="{procure>/cwipDraft/remarks}"
                            rows="2" width="100%" growing="true" growingMaxLines="5" maxLength="600"
                            placeholder="Site readiness, liquidated damages, inspection requirements."/>
                    </VBox>
                </VBox>

                <!-- ==========================================================
                     SAP INTEGRATION PREVIEW
                     ========================================================== -->
                <VBox class="zcpxCard zcpxSection">
                    <HBox class="zcpxCardHeader" alignItems="Center">
                        <core:Icon src="sap-icon://synchronize" class="sapUiTinyMarginEnd"/>
                        <Text text="{i18n>sapSyncTitle}" class="zcpxCardTitle"/>
                    </HBox>
                    <Table items="{config>/sapSync}" class="sapUiSizeCompact">
                        <columns>
                            <Column><Text text="{i18n>portalAction}"/></Column>
                            <Column><Text text="{i18n>sapResult}"/></Column>
                            <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>timing}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{config>action}"/>
                                    <ObjectStatus
                                        text="{config>sapResult}"
                                        state="Success"
                                        icon="sap-icon://sys-enter-2"/>
                                    <Text text="{config>timing}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button text="{i18n>saveDraft}" icon="sap-icon://save" press=".onSaveDraft"/>
                <Button
                    text="{i18n>pushToSap}"
                    icon="sap-icon://upload-to-cloud"
                    type="Emphasized"
                    enabled="{= !${detail>/vendorCodeBlocked} }"
                    press=".onPushToSap"/>
                <Button text="{i18n>cancel}" press=".onBack"/>
            </OverflowToolbar>
        </footer>

    </Page>

</mvc:View>
