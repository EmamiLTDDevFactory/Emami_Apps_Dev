{
  "name": "auditee-response",
  "version": "0.1.0",
  "private": true,
  "description": "Auditee Response: auditees answer internal audit observations and submit them to the reviewer (replaces SAP Web Dynpro ZAUDIT_TOOL)",
  "scripts": {
    "dev": "next dev -p 3330",
    "build": "next build && node scripts/rename-export.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@playwright/test": "1.63.0",
    "axe-core": "^4.14.0"
  }
}
