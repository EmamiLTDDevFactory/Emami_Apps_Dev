# Postgres (Development Environment DB) — copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.
PGHOST=10.17.12.4
PGPORT=5432
PGDATABASE=Devhubfactory
PGUSER=Devhubuser
PGPASSWORD=

# SAP/Azure OAuth (client credentials flow, used by server.js). No values are
# hardcoded in source — fill these in on the deploy server's own .env file.
AZURE_OAUTH_TOKEN_URL=https://login.microsoftonline.com/d016aebd-1f96-4dd1-a22b-eeb0201fb61e/oauth2/token?sap-client=100
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SCOPE=api://<client-id>/Sap.Odata.Access
