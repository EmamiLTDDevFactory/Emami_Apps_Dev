# BOM Cost Explorer - SAP connection. The browser calls the Azure SAP gateway directly (no server
# in between). In the static build only NEXT_PUBLIC_* values reach the browser; the plain SAP_*
# names are for node tools (npm run check:metadata, tests).
#
# SAP_BASE_URL is DERIVED: ${SAP_GATEWAY_HOST}/api/${SAP_SYSTEM}/${SAP_SERVICE}
# Without SAP_SYSTEM / APP_ENV the hostname decides: dev.* -> NGD/development, *qa* -> NGQ/qa,
# www / apex -> NWP/production, localhost -> NGD/development.

NEXT_PUBLIC_SAP_GATEWAY_HOST=https://emdcindpwebapp1-bag2gfhjd9d4gkh6.centralindia-01.azurewebsites.net
NEXT_PUBLIC_SAP_SERVICE=ZMM_BOM_COST_SRV

# --- pick ONE system (guards: NWP only with APP_ENV=production, production only with NWP) ------
# Development
# NEXT_PUBLIC_SAP_SYSTEM=NGD
# NEXT_PUBLIC_APP_ENV=development
# Quality
# NEXT_PUBLIC_SAP_SYSTEM=NGQ
# NEXT_PUBLIC_APP_ENV=qa
# Production
# NEXT_PUBLIC_SAP_SYSTEM=NWP
# NEXT_PUBLIC_APP_ENV=production

# none | basic | bearer | apikey. The browser accepts only "none" (credentials are never bundled);
# the other modes are for node tools against a gateway that needs them:
NEXT_PUBLIC_SAP_AUTH_MODE=none
# SAP_AUTH_MODE=basic
# SAP_AUTH_USER=
# SAP_AUTH_PASSWORD=
# SAP_AUTH_TOKEN=            # bearer
# SAP_AUTH_HEADER_NAME=      # apikey
# SAP_AUTH_HEADER_VALUE=     # apikey

# Only set when the gateway needs it (the Azure proxy may add sap-client itself).
# NEXT_PUBLIC_SAP_CLIENT=100

NEXT_PUBLIC_SAP_TIMEOUT_MS=230000
# auto | on | off  - RateOptions via CostLineSet?$expand=RateOptions (mode B only)
NEXT_PUBLIC_SAP_EXPAND_RATE_OPTIONS=auto

# Local development only: run against the built-in mock instead of SAP (npm run dev:mock).
# NEXT_PUBLIC_MOCK_SAP=true

# Node tools (check:metadata) read the same settings without the NEXT_PUBLIC_ prefix, e.g.
# SAP_GATEWAY_HOST=... SAP_SYSTEM=NGD APP_ENV=development npm run check:metadata

# Rate options probe (lib/rates): a small known material + plant used once to find out whether SAP
# serves RateOptionSet (direct) or $expand=RateOptions. Unset = the user's own query is the probe.
# NEXT_PUBLIC_RATES_PROBE_MATNR=400016291
# NEXT_PUBLIC_RATES_PROBE_WERKS=UB01

# Production Plan module (phases 2-5): off unless set to true at build time.
# PLAN_MODULE_ENABLED=true

# AI layer (explain change, costing assistant). Off unless true. No server key: each user types their own Claude API
# key on the AI settings screen (kept in the browser, sent only to Anthropic).
# AI_ENABLED=true
# NEXT_PUBLIC_AI_MASK_VENDORS=true      # vendor names become V1, V2 ... in everything sent to the model
# NEXT_PUBLIC_SNAPSHOTS_ENABLED=true    # keep run snapshots in this browser for "compare with a previous run" (defaults to AI_ENABLED)
# ANTHROPIC_API_KEY=                    # only for `npm run eval` (golden questions against the mock SAP)
# AI_EVAL_MODEL=claude-sonnet-5-5

# Daily cost watch pages (needs AI_ENABLED too). The 06:00 job, database and mail live on the hub backend
# (backend/costWatch.js, its own WATCH_ENABLED / WATCH_SCHEDULER in the server .env).
# WATCH_ENABLED=true

# Plant-wide costing: one plant + Materials empty = all header materials of the plant, batched, no time limit.
# PLANT_WIDE_ENABLED=true
# PLANT_WIDE_BATCH=25              # headers per SAP request (max 50)
# PLANT_WIDE_MTART=FERT            # header material types, comma list
# PLANT_WIDE_MAX_CONCURRENCY=1
# PLANT_WIDE_CONFIRM_ABOVE=0       # 0 = no confirmation; else a plain confirm button above this many headers
# VH_CAP=500                       # rows SAP returns at most per MaterialVHSet call
