# --- SAP (server-side only; never exposed to the browser) ---------------------------------------
SAP_BASE_URL=https://<host>:<port>/sap/opu/odata/sap/ZMM_BOM_COST_SRV
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
# Per-request timeout for SAP calls, ms. Costing runs for 50 headers can take a while.
SAP_TIMEOUT_MS=120000
# Set to true to run the whole app against the built-in mock SAP (no SAP connection needed).
MOCK_SAP=false

# --- Auth -------------------------------------------------------------------------------------------
# Signs this app's session tokens (NextAuth JWT). Long random string, different per environment.
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Origins allowed to call this BFF (the hub serves the embedded UI). Comma separated.
ALLOWED_ORIGINS=https://dev.emamiapps.in,https://www.emamiapps.in,https://emamiapps.in,http://localhost:3210
# Must equal the Emami Apps hub's HUB_AUTH_JWT_SECRET (dev and prod hubs differ).
HUB_AUTH_JWT_SECRET=
# Manage Access lookup: the user must hold a role on this app id. Leave HUB_ACCESS_API_BASE empty
# to skip the role check (allowed plants still apply).
HUB_ACCESS_API_BASE=https://audit-capa-api.emamiapps.in/api
HUB_APP_ID=bom-cost-explorer
# Plant authorisation, JSON: email (lower-case) or "*" -> list of plants, "*" = every plant.
PLANT_ACCESS={"*":["*"]}
# Allow the "demo sign-in" form (pick an email + plants). Always allowed when MOCK_SAP=true.
ALLOW_DEMO_LOGIN=false

# --- Limits -------------------------------------------------------------------------------------
RATE_LIMIT_COST_PER_MIN=12
RATE_LIMIT_LOOKUP_PER_MIN=240
# Server build only: serve under a sub-path. Leave empty when nginx strips /api/bom-cost/.
BASE_PATH=
# Static (embedded) build only: override the BFF URL the UI calls (default: per hostname, see
# src/lib/client/session.ts).
# NEXT_PUBLIC_BFF_URL=
