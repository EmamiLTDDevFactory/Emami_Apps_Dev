PORT=4000

# Origins allowed to call this API (CORS) — comma-separated. Must include the deployed hub
# frontend's real origin (https://www.emamiapps.in), same pattern as
# embedded-apps/audit-capa/backend's CLIENT_URL.
CLIENT_URL=http://localhost:5173,https://www.emamiapps.in

# PostgreSQL connection. schema.sql lives entirely inside its own "timesheet" schema (see
# pool.js's search_path) specifically so this app can share the SAME database instance as
# embedded-apps/audit-capa/backend (and, on prod, the root backend/ + MoldHealthCheck DB at
# 10.17.12.4) without colliding with their tables. On the always-on internal machine this ends up
# deployed on, point these at that same shared Postgres instance/credentials — ask whoever holds
# audit-capa's real (gitignored) .env for the actual PGHOST/PGDATABASE/PGUSER/PGPASSWORD. Local
# dev only: point at your own local Postgres instead.
PGHOST=localhost
PGPORT=5432
PGDATABASE=timesheet
PGUSER=postgres
PGPASSWORD=

# Must match the Emami Apps hub's own HUB_AUTH_JWT_SECRET (backend/sessionAuth.js at the repo
# root) exactly — this is what lets this backend trust a session the hub already authenticated,
# same pattern as embedded-apps/audit-capa/backend's own copy of this variable. See routes/auth.js.
HUB_AUTH_JWT_SECRET=

# TimeSheet's own session token, issued only after the hub token above has been verified (see
# middleware/auth.js) — a separate secret only this backend needs to know.
SESSION_JWT_SECRET=change_me
SESSION_EXPIRES_IN=30d

# Local/dev only — enables the demo "log in as" picker's own login route (routes/auth.js's
# /demo-users and /demo-login). Leave unset in the real deployed .env; those routes 404 outright
# without it, so the demo picker can never be reached by a real hub user in production.
ALLOW_DEMO_LOGIN=true

# The hub's own Manage Access API base this backend checks a person's 'timesheet' role against
# (see routes/auth.js). Defaults to the dev-pointed hub backend (Emami_Apps_Dev's own Manage
# Access data lives at /dev-api/api, separate from prod's) — override to the prod path
# (https://audit-capa-api.emamiapps.in/api) once this app is deployed there instead.
HUB_ACCESS_API_BASE=https://audit-capa-api.emamiapps.in/dev-api/api
