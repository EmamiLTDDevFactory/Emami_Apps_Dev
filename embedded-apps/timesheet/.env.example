# Absolute base URL of the Timesheet API host — the standalone TimeSheet
# project's server/ (Express + Postgres), deployed on its own.
#
# Set this as an environment variable in the Amplify console so it is baked in
# at build time; never commit the real value (the hub's .gitignore ignores
# .env and .env.* but keeps this .env.example).
#
# Leave it unset for local development: src/context/AppContext.jsx then falls
# back to the relative '/api', which vite.config.js proxies to
# http://localhost:4000.
VITE_TIMESHEET_API_URL=https://<timesheet-api-host>
