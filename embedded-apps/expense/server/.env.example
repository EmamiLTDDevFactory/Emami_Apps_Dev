# Expense backend — currently just one endpoint: POST /api/expense/extract-document, which reads
# GSTIN/HSN/total-amount off an uploaded receipt via Claude's document understanding.
# Copy this file to .env and fill in real values. .env is gitignored; never commit real credentials.

PORT=4102

# Comma-separated list of origins allowed to call this API (CORS). Add the expense app's real
# Amplify domain(s) alongside localhost once known.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8081

# Leaving this unset makes /api/expense/extract-document return 503 "not_configured" rather than
# erroring - uploads still work fine, GSTIN/HSN/Amount just aren't auto-filled until this is set.
ANTHROPIC_API_KEY=

# Optional, free alternative to Claude for document extraction (images only, not PDFs). Set both
# of these to try it; any Groq failure falls back to Claude automatically per-request. To revert
# to Claude-only, just unset EXTRACTION_PROVIDER (or set it to anything but 'groq') and restart -
# no code change needed.
EXTRACTION_PROVIDER=
GROQ_API_KEY=

# Alternative to the above: a self-hosted GLM-OCR model running as its own process on this same
# machine (see server/glm_service.py, run under its own pm2 name - not this one). Set
# EXTRACTION_PROVIDER=glm to use it. Images only, same reasoning as Groq. Falls back to Claude
# automatically on any failure.
GLM_SERVICE_URL=http://127.0.0.1:4200
