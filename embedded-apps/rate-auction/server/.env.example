# Copy to .env and fill in. Never commit real values.
# Planned deployment (same box and pattern as timesheet-api): 172.17.2.21, PM2, ONE fork-mode
# process per environment - rate-auction-api-dev on 4110 and rate-auction-api on 4111, behind
# nginx at /dev-api/rate-auction/ and /api/rate-auction/ (see src/lib/api.ts in the frontend).
PORT=4110

# Origins allowed to call this API (CORS), comma-separated.
CLIENT_URL=http://localhost:3000,https://dev.emamiapps.in,https://www.emamiapps.in

# Must match the Emami Apps hub's HUB_AUTH_JWT_SECRET exactly. Dev and prod hubs sign with
# different secrets: the dev process needs dev's value, the prod process prod's.
HUB_AUTH_JWT_SECRET=

# This app's own session token secret (any long random string, different per environment).
SESSION_JWT_SECRET=change_me
SESSION_EXPIRES_IN=12h

# Local/standalone only: enables the "sign in as admin / vendor" picker. Leave unset when deployed.
ALLOW_DEMO_LOGIN=true

# Manage Access APIs the 'rate-auction' role is read from (picked per request from the caller's
# Origin: hostname containing 'dev' -> _DEV). Defaults shown; set only to override.
# HUB_ACCESS_API_BASE_PROD=https://audit-capa-api.emamiapps.in/api
# HUB_ACCESS_API_BASE_DEV=https://audit-capa-api.emamiapps.in/dev-api/api
# HUB_ACCESS_API_BASE=

# ---- Where master data and SAP documents come from ----
# mock = sample data (default) | rfc = SAP ECC through RFC | odata = S/4HANA / Gateway
SAP_MODE=mock

# ---- Where the auction itself is saved ----
# memory = in this process only (default, lost on restart) | ecc = SAP custom tables ZAUC_* (see abap/)
STORE_MODE=memory

# ---- SAP ECC over RFC (SAP_MODE=rfc). Needs the SAP NetWeaver RFC SDK on this server and: npm install node-rfc
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_LANG=EN
SAP_SPRAS=E
# SAP_SAPROUTER=
SAP_TIMEOUT_MS=15000
SAP_POOL_SIZE=4

# ---- S/4HANA / Gateway over OData (SAP_MODE=odata) ----
# SAP_BASE_URL=
# SAP_AUTH=basic
