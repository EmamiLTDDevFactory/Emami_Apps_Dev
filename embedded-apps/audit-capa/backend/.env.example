PORT=5000
CLIENT_URL=http://localhost:3000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=audit_management
DATABASE_URL=postgres://postgres:your_password@localhost:5432/audit_management

JWT_SECRET=change_me
JWT_EXPIRES_IN=8h

# Must match the Emami Apps hub's own HUB_AUTH_JWT_SECRET exactly — this is what lets this backend
# trust a session the hub already authenticated, instead of Audit & CAPA having its own separate
# login. See controllers/authController.js. On the real deployment, this needs to match whichever
# hub deployment actually issues end-user session tokens (a separate Lambda, per that repo's
# backend/.env.example) — NOT necessarily the PM2-hosted hub backend's own copy of this variable,
# which turned out to already differ from this one.
HUB_AUTH_JWT_SECRET=

# Shared secret for the hub's Manage Access backend to call this app's routes/internal.js (CQA/Depot
# role sync — see controllers/internalController.js) — must exactly match the hub backend's own
# AUDIT_CAPA_SYNC_SECRET (see repo root backend/.env.example). Deliberately separate from
# HUB_AUTH_JWT_SECRET above for the same reason noted there. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_CAPA_SYNC_SECRET=
