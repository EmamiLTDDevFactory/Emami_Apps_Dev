PORT=5000
CLIENT_URL=http://localhost:3000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=audit_management
DATABASE_URL=postgres://postgres:your_password@localhost:5432/audit_management

JWT_SECRET=change_me
JWT_EXPIRES_IN=8h

# Must match the Emami Apps hub's own HUB_AUTH_JWT_SECRET (backend/sessionAuth.js at the repo
# root) exactly — this is what lets this backend trust a session the hub already authenticated,
# instead of Audit & CAPA having its own separate login. See controllers/authController.js.
HUB_AUTH_JWT_SECRET=
