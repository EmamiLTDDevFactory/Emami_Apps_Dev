# Copy to .env for local dev. In Amplify, this is written into .env at build
# time from an Amplify Console environment variable (see amplify.yml).
#
# The hub-auth Lambda (backend/), fronted by API Gateway (see scripts/deploy-lambdas.js
# and backend/hub-auth.js) — serves both login (direct email + Microsoft SAML) and the
# Manage Access API.
EXPO_PUBLIC_AUTH_API_URL=http://localhost:4000/api

# Manage Access (src/lib/accessApi.ts) and profile/activity (getMyProfile/logEvent in
# src/lib/authApi.ts) — a separate, Postgres-reachable backend (172.17.2.21 /
# audit-capa-api.emamiapps.in). Login and Microsoft SAML SSO stay on EXPO_PUBLIC_AUTH_API_URL
# above (the hub-auth Lambda) — see accessApi.ts for why. Falls back to EXPO_PUBLIC_AUTH_API_URL
# if unset.
EXPO_PUBLIC_ACCESS_API_URL=http://localhost:4000/api
